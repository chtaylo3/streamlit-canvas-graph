# Copy this file to .secrets.toml and populate only the credentials you need.
# .secrets.toml is ignored by Git and must never be committed.
#
# Create both credentials as fine-grained personal access tokens at:
# GitHub -> Settings -> Developer settings -> Personal access tokens
#        -> Fine-grained tokens.
#
# READ TOKEN (used only by `scg ingest github`)
# ------------------------------------------------------------
# Resource owner:
#   The personal account whose repositories will be ingested.
# Repository access:
#   Prefer "Only select repositories" and select only the private/public
#   repositories that should be available to this tool. Use "All repositories"
#   only when runtime discovery of every owned repository is required.
# Repository permissions:
#   Contents: Read-only
#   Metadata: Read-only (GitHub automatically includes this permission)
# Account permissions:
#   None required.
# Why:
#   Contents read is required for Git trees, manifests, lockfiles, licenses,
#   commits, and the GitHub dependency-graph SBOM endpoint. Metadata read is
#   required to discover/list repositories visible to the authenticated user.
github_read_token = "github_pat_replace_me"

# PROVISION TOKEN (used only by `scg provision create` and `cleanup`)
# ------------------------------------------------------------
# Use a separate token; never reuse the read-only token above.
# Resource owner:
#   The personal account where private test repositories will be created.
# Repository access:
#   All repositories. This is required so the token applies to repositories
#   created after the token itself was issued. Keep this token short-lived.
# Repository permissions:
#   Administration: Read and write  (create/configure/delete repositories)
#   Contents: Read and write        (push the copied default branch)
#   Workflows: Read and write       (source repos may contain .github/workflows)
#   Metadata: Read-only             (GitHub automatically includes this)
# Account permissions:
#   None required.
# Why:
#   The provisioner creates a new private repository, pushes a shallow copy of
#   the source's default branch, and can permanently delete only repositories
#   allowlisted in the local provisioning manifest.
github_provision_token = "github_pat_replace_me_with_a_separate_write_token"

# Security guidance:
# - Set the shortest practical expiration date and rotate tokens after testing.
# - Do not paste tokens into commands, settings.toml, the repository catalog,
#   issue trackers, logs, screenshots, or committed files.
# - If a token is exposed, revoke it immediately and create a replacement.
